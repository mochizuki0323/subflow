# Build outputs
build/
build-mingw/
dist/
release/

# Dependencies
node_modules/

# Cache / build info
.cache/
tsconfig.tsbuildinfo

# Runtime configuration (user-specific)
config/
app-settings.json
deepgram-config.json
translator-config.json
ui-preferences.json
window-positions.json

# Personal scripts
claude_code.sh
claude_code_openrouter.sh

