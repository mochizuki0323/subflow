scripts/generate-icon.sh

# ML models (large binaries, download separately)
models/

# Vendored C++ deps — all fetched by scripts (scripts/setup-deps.sh +
# scripts/setup-sherpa-onnx.sh); nothing under extern/ is committed.
extern/


# Standalone Parakeet server build output
server/build/

# Local test models for the Parakeet inference server (large binaries, not committed)
test-models/

# Windows mark-of-the-web alternate data streams
*:Zone.Identifier
